class BestEngineLogger : public nvinfer1::ILogger
{
public:
    void log(
        Severity severity,
        const char *msg) noexcept override
    {
        if (severity <= Severity::kWARNING)
        {
            std::cerr
                << "[BEST ENGINE] "
                << msg
                << std::endl;
        }
    }
};

static BestEngineLogger g_best_logger;

class BestEngineDetector
{
public:
    bool initialize();
    bool detect(
        const cv::Mat &frame,
        cv::Rect &best_crosswalk);

    ~BestEngineDetector();

private:
    nvinfer1::IRuntime *runtime_ = nullptr;
    nvinfer1::ICudaEngine *engine_ = nullptr;
    nvinfer1::IExecutionContext *context_ = nullptr;

    void *gpu_input_ = nullptr;
    void *gpu_output_ = nullptr;

    cudaStream_t stream_ = nullptr;

    std::vector<float> host_input_;
    std::vector<float> host_output_;

    bool initialized_ = false;
};

static BestEngineDetector g_best_detector;

static bool g_crosswalk_line_valid = false;
