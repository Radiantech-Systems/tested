 *   nvurisrcbin -> streammux -> nvinfer -> nvdsosd -> tee
 *        |                                             |-- queue -> fakesink
 *        |                                             |-- queue -> nvvideoconvert ->
 *        |                                             |            capsfilter -> nvjpegenc ->
 *        |                                             |            appsink
 *        |                                             |-- queue -> nvrtspoutsinkbin
 *
 * ============================================================
 */

