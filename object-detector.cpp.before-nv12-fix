static constexpr int BEST_INPUT_W = 640;
static constexpr int BEST_INPUT_H = 640;
static constexpr int BEST_NUM_CLASSES = 9;
static constexpr int BEST_NUM_PREDICTIONS = 8400;
static constexpr float BEST_CONF_THRESHOLD = 0.30f;
static constexpr float BEST_NMS_THRESHOLD = 0.45f;
static constexpr float BEST_LINE_POSITION = 0.85f;

