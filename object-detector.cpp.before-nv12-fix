/* Dummy traffic signal state */
static const auto signal_start_time =
    std::chrono::steady_clock::now();

enum class TrafficSignalState
{
    GREEN,
    RED
};

static TrafficSignalState get_traffic_signal_state()
{
    auto now = std::chrono::steady_clock::now();

    auto elapsed =
        std::chrono::duration_cast<
            std::chrono::seconds>(
                now - signal_start_time)
        .count();

    const long cycle =
        GREEN_DURATION_SECONDS +
        RED_DURATION_SECONDS;

    const long position =
        elapsed % cycle;

    if (position < GREEN_DURATION_SECONDS)
        return TrafficSignalState::GREEN;

    return TrafficSignalState::RED;
}

