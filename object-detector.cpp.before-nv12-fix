/* ============================================================
 * best.engine TensorRT initialization
 * ============================================================ */

bool BestEngineDetector::initialize()
{
    if (initialized_)
        return true;

    std::ifstream file(
        BEST_ENGINE_FILE,
        std::ios::binary);

    if (!file)
    {
        std::cerr
            << "[BEST ENGINE] Cannot open: "
            << BEST_ENGINE_FILE
            << std::endl;

        return false;
    }

    file.seekg(
        0,
        std::ios::end);

    const std::streamsize size =
        file.tellg();

    file.seekg(
        0,
        std::ios::beg);

    std::vector<char> engine_data(
        static_cast<size_t>(size));

    if (!file.read(
            engine_data.data(),
            size))
    {
        std::cerr
            << "[BEST ENGINE] Failed reading engine"
            << std::endl;

        return false;
    }

    runtime_ =
        nvinfer1::createInferRuntime(
            g_best_logger);

    if (!runtime_)
    {
        std::cerr
            << "[BEST ENGINE] createInferRuntime failed"
            << std::endl;

        return false;
    }

    engine_ =
        runtime_->deserializeCudaEngine(
            engine_data.data(),
            engine_data.size());

    if (!engine_)
    {
        std::cerr
            << "[BEST ENGINE] deserializeCudaEngine failed"
            << std::endl;

        return false;
    }

    context_ =
        engine_->createExecutionContext();

    if (!context_)
    {
        std::cerr
            << "[BEST ENGINE] createExecutionContext failed"
            << std::endl;

        return false;
    }

    nvinfer1::Dims4 input_dims(
        1,
        3,
        BEST_INPUT_H,
        BEST_INPUT_W);

    if (!context_->setInputShape(
            BEST_INPUT_NAME,
            input_dims))
    {
        std::cerr
            << "[BEST ENGINE] setInputShape failed"
            << std::endl;
        return false;
    }

    host_input_.resize(
        1ULL *
        3 *
        BEST_INPUT_H *
        BEST_INPUT_W);

    host_output_.resize(
        1ULL *
        (4 + BEST_NUM_CLASSES) *
        BEST_NUM_PREDICTIONS);

    if (cudaMalloc(
            &gpu_input_,
            host_input_.size() *
                sizeof(float)) != cudaSuccess)
    {
        std::cerr
            << "[BEST ENGINE] cudaMalloc input failed"
            << std::endl;

        return false;
    }

    if (cudaMalloc(
            &gpu_output_,
            host_output_.size() *
                sizeof(float)) != cudaSuccess)
    {
        std::cerr
            << "[BEST ENGINE] cudaMalloc output failed"
            << std::endl;

        return false;
    }

    if (cudaStreamCreate(
            &stream_) != cudaSuccess)
    {
        std::cerr
            << "[BEST ENGINE] cudaStreamCreate failed"
            << std::endl;

        return false;
    }

    if (!context_->setTensorAddress(
            BEST_INPUT_NAME,
            gpu_input_))
    {
        std::cerr
            << "[BEST ENGINE] input tensor address failed"
            << std::endl;

        return false;
    }

    if (!context_->setTensorAddress(
            BEST_OUTPUT_NAME,
            gpu_output_))
    {
        std::cerr
            << "[BEST ENGINE] output tensor address failed"
            << std::endl;

        return false;
    }

    initialized_ = true;

    std::cout
        << "[BEST ENGINE] Ready: "
        << BEST_ENGINE_FILE
        << std::endl;

    return true;
}


/* ============================================================
 * best.engine inference
 * ============================================================ */

bool BestEngineDetector::detect(
    const cv::Mat &frame,
    cv::Rect &best_crosswalk)
{
    if (!initialized_ ||
        frame.empty())
    {
        return false;
    }

    float scale =
        std::min(
            static_cast<float>(BEST_INPUT_W) /
                static_cast<float>(frame.cols),
            static_cast<float>(BEST_INPUT_H) /
                static_cast<float>(frame.rows));

    int resized_w =
        static_cast<int>(
            frame.cols * scale);

    int resized_h =
        static_cast<int>(
            frame.rows * scale);

    int pad_x =
        (BEST_INPUT_W - resized_w) / 2;

    int pad_y =
        (BEST_INPUT_H - resized_h) / 2;

    cv::Mat resized;

    cv::resize(
        frame,
        resized,
        cv::Size(
            resized_w,
            resized_h));

    cv::Mat letterbox(
        BEST_INPUT_H,
        BEST_INPUT_W,
        CV_8UC3,
        cv::Scalar(
            114,
            114,
            114));

    resized.copyTo(
        letterbox(
            cv::Rect(
                pad_x,
                pad_y,
                resized_w,
                resized_h)));

    cv::Mat rgb;

    cv::cvtColor(
        letterbox,
        rgb,
        cv::COLOR_BGR2RGB);

    size_t channel_size =
        static_cast<size_t>(
            BEST_INPUT_W) *
        BEST_INPUT_H;

    for (int y = 0; y < BEST_INPUT_H; ++y)
    {
        const cv::Vec3b *row =
            rgb.ptr<cv::Vec3b>(y);

        for (int x = 0; x < BEST_INPUT_W; ++x)
        {
            const cv::Vec3b &pixel =
                row[x];

            size_t index =
                static_cast<size_t>(y) *
                    BEST_INPUT_W +
                x;

            host_input_[index] =
                pixel[0] / 255.0f;

            host_input_[
                channel_size + index] =
                pixel[1] / 255.0f;

            host_input_[
                2 * channel_size + index] =
                pixel[2] / 255.0f;
        }
    }

    if (cudaMemcpyAsync(
            gpu_input_,
            host_input_.data(),
            host_input_.size() *
                sizeof(float),
            cudaMemcpyHostToDevice,
            stream_) != cudaSuccess)
    {
        return false;
    }

    if (!context_->enqueueV3(
            stream_))
    {
        std::cerr
            << "[BEST ENGINE] enqueueV3 failed"
            << std::endl;

        return false;
    }

    if (cudaMemcpyAsync(
            host_output_.data(),
            gpu_output_,
            host_output_.size() *
                sizeof(float),
            cudaMemcpyDeviceToHost,
            stream_) != cudaSuccess)
    {
        return false;
    }

    if (cudaStreamSynchronize(
            stream_) != cudaSuccess)
    {
        return false;
    }

    std::vector<cv::Rect> boxes;
    std::vector<float> confidences;
    float max_crosswalk_score = 0.0f;

    for (int i = 0;
         i < BEST_NUM_PREDICTIONS;
         ++i)
    {
        float cx =
            host_output_[i];

        float cy =
            host_output_[
                BEST_NUM_PREDICTIONS + i];

        float w =
            host_output_[
                2 * BEST_NUM_PREDICTIONS + i];

        float h =
            host_output_[
                3 * BEST_NUM_PREDICTIONS + i];

        float best_score = 0.0f;
        int best_class = -1;

        for (int c = 0;
             c < BEST_NUM_CLASSES;
             ++c)
        {
            float score =
                host_output_[
                    (4 + c) *
                        BEST_NUM_PREDICTIONS +
                    i];

            if (score > best_score)
            {
                best_score = score;
                best_class = c;
            }
        }
        float crosswalk_score = host_output_[4 * BEST_NUM_PREDICTIONS + i];
        if (crosswalk_score > max_crosswalk_score)
        {
            max_crosswalk_score = crosswalk_score;
        }

        if (best_class == 4 && best_score >= 0.10f) {
            std::cout << "[BEST DEBUG] CROSSWALK CANDIDATE score="
                      << best_score << std::endl;
        }
        /* Class 4 = Crosswalk */
        if (best_class != 4 ||
            best_score <
                BEST_CONF_THRESHOLD)
        {
            continue;
        }

        float x =
            cx -
            w / 2.0f;

        float y =
            cy -
            h / 2.0f;

        x =
            (x - pad_x) /
            scale;

        y =
            (y - pad_y) /
            scale;

        w /= scale;
        h /= scale;

        cv::Rect box(
            static_cast<int>(x),
            static_cast<int>(y),
            static_cast<int>(w),
            static_cast<int>(h));

        box &=
            cv::Rect(
                0,
                0,
                frame.cols,
                frame.rows);

        if (box.width > 0 &&
            box.height > 0)
        {
            boxes.push_back(box);
            confidences.push_back(
                best_score);
        }
    }

    std::cout << "[BEST DEBUG] MAX CROSSWALK SCORE="
              << max_crosswalk_score << std::endl;

    if (boxes.empty())
        return false;

    std::vector<int> indices;

    cv::dnn::NMSBoxes(
        boxes,
        confidences,
        BEST_CONF_THRESHOLD,
        BEST_NMS_THRESHOLD,
        indices);

    if (indices.empty())
        return false;

    int best_index =
        indices[0];

    int best_area =
        boxes[best_index].area();

    for (size_t i = 1;
         i < indices.size();
         ++i)
    {
        int idx =
            indices[i];

        if (boxes[idx].area() >
            best_area)
        {
            best_area =
                boxes[idx].area();

            best_index =
                idx;
        }
    }

    best_crosswalk =
        boxes[best_index];

    return true;
}


BestEngineDetector::~BestEngineDetector()
{
    if (stream_)
        cudaStreamDestroy(stream_);

    if (gpu_input_)
        cudaFree(gpu_input_);

    if (gpu_output_)
        cudaFree(gpu_output_);

    if (context_)
        delete context_;

    if (engine_)
        delete engine_;

    if (runtime_)
        delete runtime_;
}

