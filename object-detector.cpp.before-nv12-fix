 * ============================================================
 */


/*
 * ============================================================
 * Stage 1: best.engine Crosswalk detection
 *
 * Runs before nvdsosd so the virtual line is rendered by OSD.
 * Existing infer_src_probe() remains untouched.
 * ============================================================
 */

static GstPadProbeReturn crosswalk_best_engine_probe(
    GstPad *,
    GstPadProbeInfo *info,
    gpointer)
{
    GstBuffer *buf =
        GST_PAD_PROBE_INFO_BUFFER(info);

    if (!buf)
        return GST_PAD_PROBE_OK;

    NvDsBatchMeta *batch_meta =
        gst_buffer_get_nvds_batch_meta(buf);

    if (!batch_meta)
        return GST_PAD_PROBE_OK;

    auto now =
        std::chrono::steady_clock::now();

    /*
     * Only run best.engine when a new Crosswalk check
     * is required. While the 120-second lock is active,
     * no TensorRT inference is performed.
     */
    bool detection_due =
        !crosswalk_line_locked ||
        now >= next_crosswalk_line_check;

    if (detection_due)
    {
        bool crosswalk_found = false;
        cv::Rect best_crosswalk;
        float best_area = 0.0f;

        for (
            NvDsMetaList *l_frame =
                batch_meta->frame_meta_list;
            l_frame;
            l_frame = l_frame->next)
        {
            auto *frame_meta =
                static_cast<NvDsFrameMeta *>(
                    l_frame->data);

            if (!frame_meta)
                continue;

            guint batch_id =
                frame_meta->batch_id;

            NvBufSurface *surface = nullptr;

            GstMapInfo map_info{};

            if (!gst_buffer_map(
                    buf,
                    &map_info,
                    GST_MAP_READ))
            {
                std::cerr
                    << "[BEST ENGINE] "
                       "Failed to map GstBuffer."
                    << std::endl;
                continue;
            }

            surface =
                reinterpret_cast<NvBufSurface *>(
                    map_info.data);

            if (!surface ||
                batch_id >= surface->numFilled)
            {
                gst_buffer_unmap(
                    buf,
                    &map_info);
                continue;
            }

            NvBufSurfaceParams &params =
                surface->surfaceList[batch_id];

            int width =
                static_cast<int>(params.width);

            int height =
                static_cast<int>(params.height);

            cv::Mat frame_bgr;

            static bool best_surface_debug_printed = false;
            if (!best_surface_debug_printed)
            {
                std::cout << "[BEST SURFACE] width=" << width
                          << " height=" << height
                          << " colorFormat=" << params.colorFormat
                          << " pitch=" << params.pitch
                          << std::endl;
                best_surface_debug_printed = true;
            }

            /*
             * DeepStream normally delivers NV12 into
             * nvdsosd for this pipeline. Handle RGBA too.
             */
            if (params.colorFormat ==
                NVBUF_COLOR_FORMAT_RGBA)
            {
                if (NvBufSurfaceMap(
                        surface,
                        batch_id,
                        0,
                        NVBUF_MAP_READ) != 0)
                {
                    gst_buffer_unmap(
                        buf,
                        &map_info);
                    continue;
                }

                NvBufSurfaceSyncForCpu(
                    surface,
                    batch_id,
                    0);

                cv::Mat rgba(
                    height,
                    width,
                    CV_8UC4,
                    surface->surfaceList[
                        batch_id].mappedAddr.addr[0],
                    surface->surfaceList[
                        batch_id].pitch);

                cv::cvtColor(
                    rgba,
                    frame_bgr,
                    cv::COLOR_RGBA2BGR);

                NvBufSurfaceUnMap(
                    surface,
                    batch_id,
                    0);
            }
            else
            {
                /*
                 * NV12 path.
                 */
                if (NvBufSurfaceMap(
                        surface,
                        batch_id,
                        0,
                        NVBUF_MAP_READ) != 0)
                {
                    gst_buffer_unmap(
                        buf,
                        &map_info);
                    continue;
                }

                if (NvBufSurfaceMap(
                        surface,
                        batch_id,
                        1,
                        NVBUF_MAP_READ) != 0)
                {
                    NvBufSurfaceUnMap(
                        surface,
                        batch_id,
                        0);

                    gst_buffer_unmap(
                        buf,
                        &map_info);
                    continue;
                }

                NvBufSurfaceSyncForCpu(
                    surface,
                    batch_id,
                    0);

                NvBufSurfaceSyncForCpu(
                    surface,
                    batch_id,
                    1);

                cv::Mat y_plane(
                    height,
                    width,
                    CV_8UC1,
                    surface->surfaceList[
                        batch_id].mappedAddr.addr[0],
                    surface->surfaceList[
                        batch_id].pitch);

                cv::Mat uv_plane(
                    height / 2,
                    width / 2,
                    CV_8UC2,
                    surface->surfaceList[
                        batch_id].mappedAddr.addr[1],
                    surface->surfaceList[
                        batch_id].planeParams.pitch[1]);

                cv::cvtColorTwoPlane(
                    y_plane,
                    uv_plane,
                    frame_bgr,
                    cv::COLOR_YUV2BGR_NV12);

                NvBufSurfaceUnMap(
                    surface,
                    batch_id,
                    1);

                NvBufSurfaceUnMap(
                    surface,
                    batch_id,
                    0);
            }

            gst_buffer_unmap(
                buf,
                &map_info);

            if (frame_bgr.empty())
            {
                continue;
            }
            static bool best_frame_saved = false;
            if (!best_frame_saved)
            {
                std::ofstream ppm("/tmp/best_engine_input.ppm", std::ios::binary);
                if (ppm)
                {
                    cv::Mat rgb;
                    cv::cvtColor(frame_bgr, rgb, cv::COLOR_BGR2RGB);
                    ppm << "P6\n"
                        << rgb.cols << " " << rgb.rows << "\n"
                        << "255\n";
                    ppm.write(
                        reinterpret_cast<const char *>(rgb.data),
                        static_cast<std::streamsize>(rgb.total() * rgb.elemSize()));
                    ppm.close();
                    std::cout << "[BEST SURFACE] Saved /tmp/best_engine_input.ppm" << std::endl;
                }
                else
                {
                    std::cerr << "[BEST SURFACE] Failed to open PPM file" << std::endl;
                }
                best_frame_saved = true;
            }

            /*
             * best.engine:
             * 640x640 input, Crosswalk = class 4.
             *
             * detect() performs:
             *   letterbox
             *   RGB conversion
             *   TensorRT inference
             *   decode
             *   NMS
             *   mapping back to original frame.
             */
            cv::Rect crosswalk_box;

            if (g_best_detector.detect(
                    frame_bgr,
                    crosswalk_box))
            {
                float area =
                    static_cast<float>(
                        crosswalk_box.area());

                if (area > best_area)
                {
                    best_area = area;
                    best_crosswalk =
                        crosswalk_box;
                    crosswalk_found = true;
                }
            }
        }

        /*
         * A check has now been performed.
         *
         * If Crosswalk was found:
         *     update the line.
         *
         * If Crosswalk was NOT found:
         *     retain the previous line.
         *
         * In both cases wait another 120 seconds
         * before performing another best.engine check.
         */
        if (crosswalk_found)
        {
            int new_line_y =
                best_crosswalk.y +
                static_cast<int>(
                    best_crosswalk.height *
                    CROSSWALK_LINE_POSITION);

            int frame_height = 1080;

            if (batch_meta->frame_meta_list)
            {
                auto *frame_meta =
                    static_cast<NvDsFrameMeta *>(
                        batch_meta->frame_meta_list->data);

                if (frame_meta &&
                    frame_meta->source_frame_height > 0)
                {
                    frame_height =
                        frame_meta->source_frame_height;
                }
            }

            new_line_y =
                std::max(
                    0,
                    std::min(
                        frame_height - 1,
                        new_line_y));

            crosswalk_line_y =
                new_line_y;

            crosswalk_line_locked =
                true;

            std::cout
                << "[BEST ENGINE] Crosswalk found. "
                   "New line Y="
                << crosswalk_line_y
                << " locked for 120 seconds."
                << std::endl;
        }
        else
        {
            if (crosswalk_line_locked)
            {
                std::cout
                    << "[BEST ENGINE] Crosswalk not "
                       "found during recheck. "
                       "Keeping previous line Y="
                    << crosswalk_line_y
                    << std::endl;
            }
            else
            {
                std::cout
                    << "[BEST ENGINE] Crosswalk not "
                       "found. No virtual line yet."
                    << std::endl;
            }
        }

        next_crosswalk_line_check =
            now +
            std::chrono::seconds(
                CROSSWALK_LINE_CHECK_SECONDS);
    }

    /*
     * Add the line BEFORE nvdsosd processes the buffer.
     * Therefore nvdsosd renders it into the existing
     * output stream.
     */
    if (crosswalk_line_locked)
    {
        for (
            NvDsMetaList *l_frame =
                batch_meta->frame_meta_list;
            l_frame;
            l_frame = l_frame->next)
        {
            auto *frame_meta =
                static_cast<NvDsFrameMeta *>(
                    l_frame->data);

            if (!frame_meta)
                continue;

            NvDsDisplayMeta *display_meta =
                nvds_acquire_display_meta_from_pool(
                    batch_meta);

            if (!display_meta)
                continue;

            display_meta->num_lines = 1;

            NvOSD_LineParams &line =
                display_meta->line_params[0];

            line.x1 = 0;
            line.y1 = crosswalk_line_y;

            line.x2 =
                frame_meta->source_frame_width;

            line.y2 =
                crosswalk_line_y;

            line.line_width = 5;

            line.line_color.red = 1.0;
            line.line_color.green = 0.0;
            line.line_color.blue = 0.0;
            line.line_color.alpha = 1.0;

            nvds_add_display_meta_to_frame(
                frame_meta,
                display_meta);
        }
    }

    return GST_PAD_PROBE_OK;
}


static GstPadProbeReturn infer_src_probe(
    GstPad *,
    GstPadProbeInfo *info,
    gpointer)
{
    std::cout << "INFER_PROBE_CALLED" << std::endl;
    GstBuffer *buf =
        GST_PAD_PROBE_INFO_BUFFER(info);

    if (!buf)
        return GST_PAD_PROBE_OK;

    NvDsBatchMeta *batch_meta =
        gst_buffer_get_nvds_batch_meta(buf);

    if (!batch_meta)
    {
        std::cout << "NO_BATCH_META" << std::endl;
        return GST_PAD_PROBE_OK;
    }

    std::cout
        << "BATCH_META_OK frames="
        << g_list_length(batch_meta->frame_meta_list)
        << std::endl;

    for (
        NvDsMetaList *l_frame =
            batch_meta->frame_meta_list;
        l_frame;
        l_frame = l_frame->next)
    {
        auto *frame_meta =
            static_cast<NvDsFrameMeta *>(
                l_frame->data);

        if (!frame_meta)
            continue;

        /* Crosswalk detection state for this frame */
        bool crosswalk_found = false;
        float crosswalk_y = 0.0f;
        float crosswalk_h = 0.0f;

        for (
            NvDsMetaList *l_obj =
                frame_meta->obj_meta_list;
            l_obj;
            l_obj = l_obj->next)
        {
            auto *obj_meta =
                static_cast<NvDsObjectMeta *>(
                    l_obj->data);

            if (!obj_meta)
                continue;

            std::string object_name =
                obj_meta->obj_label;

            /* Detect Crosswalk */
            if (object_name == "Crosswalk")
            {
                crosswalk_found = true;
                crosswalk_y = obj_meta->rect_params.top;
                crosswalk_h = obj_meta->rect_params.height;
            }

            float confidence =
                obj_meta->confidence;

            std::cout
                << "DETECTED: "
                << object_name
                << " confidence="
                << confidence
                << " object_id="
                << obj_meta->object_id
                << " x="
                << obj_meta->rect_params.left
                << " y="
                << obj_meta->rect_params.top
                << " width="
                << obj_meta->rect_params.width
                << " height="
                << obj_meta->rect_params.height
                << std::endl;

            save_snapshot_for_object(
                object_name,
                confidence);
        }

        /* ========================================================
         * Crosswalk virtual line
         * ========================================================
         */

        auto now =
            std::chrono::steady_clock::now();

        if (crosswalk_found &&
            (!crosswalk_line_locked ||
             now >= next_crosswalk_line_check))
        {
            int new_line_y =
                static_cast<int>(
                    crosswalk_y +
                    (crosswalk_h *
                     CROSSWALK_LINE_POSITION));

            int frame_height =
                frame_meta->source_frame_height;

            if (frame_height > 0)
            {
                new_line_y =
                    std::max(
                        0,
                        std::min(
                            frame_height - 1,
                            new_line_y));
            }

            crosswalk_line_y =
                new_line_y;

            crosswalk_line_locked =
                true;

            next_crosswalk_line_check =
                now +
                std::chrono::seconds(
                    CROSSWALK_LINE_CHECK_SECONDS);

            std::cout
                << "[CROSSWALK LINE] "
                << "New virtual line Y="
                << crosswalk_line_y
                << " locked for 120 seconds"
                << std::endl;
        }

        /* Draw red line through DeepStream OSD */
        if (crosswalk_line_locked)
        {
            NvDsDisplayMeta *display_meta =
                nvds_acquire_display_meta_from_pool(
                    batch_meta);

            if (display_meta)
            {
                display_meta->num_lines = 1;

                NvOSD_LineParams &line =
                    display_meta->line_params[0];

                line.x1 = 0;
                line.y1 = crosswalk_line_y;

                line.x2 =
                    frame_meta->source_frame_width;

                line.y2 =
                    crosswalk_line_y;

                line.line_width = 5;

                line.line_color.red = 1.0;
                line.line_color.green = 0.0;
                line.line_color.blue = 0.0;
                line.line_color.alpha = 1.0;

                nvds_add_display_meta_to_frame(
                    frame_meta,
                    display_meta);
            }
        }
    }

    return GST_PAD_PROBE_OK;
}


/*
 * ============================================================
 * nvurisrcbin dynamic pad -> streammux sink_0
 * ============================================================
 */

static void on_pad_added(
    GstElement *,
    GstPad *new_pad,
    gpointer user_data)
{
    GstElement *streammux =
        GST_ELEMENT(user_data);

    GstCaps *caps =
        gst_pad_get_current_caps(new_pad);

    if (!caps)
        caps =
            gst_pad_query_caps(
                new_pad,
                nullptr);

    if (!caps)
        return;

    GstStructure *structure =
        gst_caps_get_structure(caps, 0);

    const gchar *name =
        gst_structure_get_name(structure);

    std::cout
        << "nvurisrcbin pad added: "
        << name
        << std::endl;

    if (!g_str_has_prefix(
            name,
            "video/"))
    {
        gst_caps_unref(caps);
        return;
    }

    GstPad *sink_pad =
        gst_element_request_pad_simple(
            streammux,
            "sink_0");

    if (!sink_pad)
    {
        std::cerr
            << "ERROR: Cannot get "
               "nvstreammux sink_0"
            << std::endl;

        gst_caps_unref(caps);
        return;
    }

    if (gst_pad_is_linked(sink_pad))
    {
        gst_object_unref(sink_pad);
        gst_caps_unref(caps);
        return;
    }

    GstPadLinkReturn ret =
        gst_pad_link(
            new_pad,
            sink_pad);

    if (ret == GST_PAD_LINK_OK)
    {
        std::cout
            << "Video linked to nvstreammux."
            << std::endl;
    }
    else
    {
        std::cerr
            << "ERROR: Failed to link video "
               "to nvstreammux. Return="
            << ret
            << std::endl;
    }

    gst_object_unref(sink_pad);
    gst_caps_unref(caps);
}


/*
 * ============================================================
 * Bus callback
 * ============================================================
 */

static gboolean bus_callback(
    GstBus *,
    GstMessage *message,
    gpointer user_data)
{
    GMainLoop *loop =
        static_cast<GMainLoop *>(user_data);

    switch (GST_MESSAGE_TYPE(message))
    {
        case GST_MESSAGE_ERROR:
        {
            GError *error = nullptr;
            gchar *debug = nullptr;

            gst_message_parse_error(
                message,
                &error,
                &debug);

            std::cerr
                << "\nGStreamer ERROR from "
                << GST_OBJECT_NAME(message->src)
                << ": "
                << error->message
                << std::endl;

            if (debug)
            {
                std::cerr
                    << "Debug: "
                    << debug
                    << std::endl;
            }

            g_error_free(error);
            g_free(debug);

            g_main_loop_quit(loop);

            break;
        }

        case GST_MESSAGE_WARNING:
        {
            GError *error = nullptr;
            gchar *debug = nullptr;

            gst_message_parse_warning(
                message,
                &error,
                &debug);

            std::cerr
                << "\nGStreamer WARNING from "
                << GST_OBJECT_NAME(message->src)
                << ": "
                << error->message
                << std::endl;

            if (debug)
            {
                std::cerr
                    << "Debug: "
                    << debug
                    << std::endl;
            }

            g_error_free(error);
            g_free(debug);

            break;
        }

        case GST_MESSAGE_EOS:
        {
            std::cout
                << "\nEOS received."
                << std::endl;

            g_main_loop_quit(loop);

            break;
        }

        default:
            break;
    }

    return G_SOURCE_CONTINUE;
}


static gboolean stop_pipeline(
    gpointer user_data)
{
    g_main_loop_quit(
        static_cast<GMainLoop *>(user_data));

    return G_SOURCE_REMOVE;
}


/*
 * ============================================================
 * Tee helper
 * ============================================================
 */

static bool link_tee_branch(
    GstElement *tee,
    GstElement *target,
    const char *branch_name)
{
    GstPad *tee_src =
        gst_element_request_pad_simple(
            tee,
            "src_%u");

    GstPad *sink_pad =
        gst_element_get_static_pad(
            target,
            "sink");

    if (!tee_src || !sink_pad)
    {
        g_printerr(
            "Failed to get pads for tee branch: %s\n",
            branch_name);

        if (tee_src)
            gst_object_unref(tee_src);

        if (sink_pad)
            gst_object_unref(sink_pad);

        return false;
    }

    bool ok =
        (gst_pad_link(
            tee_src,
            sink_pad)
         == GST_PAD_LINK_OK);

    if (!ok)
    {
        g_printerr(
            "Failed to link tee -> %s\n",
            branch_name);
    }

    gst_object_unref(tee_src);
    gst_object_unref(sink_pad);

    return ok;
}


